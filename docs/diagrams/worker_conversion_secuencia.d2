direction: right

backend: "Backend" {
  style.fill: "#D5E8F0"
  style.stroke: "#1F4E79"
  style.stroke-width: 2
  style.font-size: 32
}

conversion: "conversion-worker" {
  style.fill: "#FFE0B2"
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.font-size: 32

  build: ".pt → .engine FP16" {
    style.fill: "#FFF3E0"
    style.stroke: "#E65100"
    style.font-size: 28
  }
}

inference: "inference-worker" {
  style.fill: "#FFE0B2"
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.font-size: 32
}

backend -> conversion.build: "conversion.sock" {
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.stroke-dash: 5
  style.font-size: 28
}

conversion.build -> backend: ".engine listo" {
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.font-size: 28
}

backend -> inference: "reload model" {
  style.stroke: "#1F4E79"
  style.stroke-width: 2
  style.stroke-dash: 3
  style.font-size: 28
}
