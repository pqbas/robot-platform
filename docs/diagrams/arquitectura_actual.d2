direction: down

robot: "Robot Platform (Modo Robot)" {
  style.fill: "#E8F4FD"
  style.stroke: "#1F4E79"
  style.stroke-width: 2

  direction: down

  camera_dev: "Cámara ZED 2i\n(USB 3.0)" {
    style.fill: "#D5E8F0"
    style.stroke: "#1F4E79"
  }

  camera_worker: "camera-worker" {
    style.fill: "#FFE0B2"
    style.stroke: "#E65100"
    style.stroke-width: 2
  }

  inference_worker: "inference-worker" {
    style.fill: "#FFE0B2"
    style.stroke: "#E65100"
    style.stroke-width: 2
  }

  recording_worker: "recording-worker" {
    style.fill: "#FFE0B2"
    style.stroke: "#E65100"
    style.stroke-width: 2
  }

  conversion_worker: "conversion-worker" {
    style.fill: "#FFE0B2"
    style.stroke: "#E65100"
    style.stroke-width: 2
  }

  backend: "Backend" {
    style.fill: "#D5E8F0"
    style.stroke: "#1F4E79"
    style.stroke-width: 2
  }

  sqlite: "SQLite" {
    style.fill: "#F5F5F5"
    style.stroke: "#999999"
    shape: cylinder
  }

  nginx: "nginx\n:8080" {
    style.fill: "#E8F5E9"
    style.stroke: "#2E7D32"
  }

  nginx -> backend: "HTTP" {
    style.stroke: "#2E7D32"
  }

  camera_dev -> camera_worker: "V4L2" {
    style.stroke: "#1F4E79"
    style.stroke-width: 2
  }

  camera_worker -> backend: "camera.sock" {
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.stroke-dash: 5
  }

  camera_worker -> recording_worker: "camera.sock" {
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.stroke-dash: 5
  }

  backend -> inference_worker: "inference.sock" {
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.stroke-dash: 5
  }

  inference_worker -> backend: "detecciones + track_id" {
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.stroke-dash: 5
  }

  backend -> recording_worker: "recording.sock" {
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.stroke-dash: 5
  }

  backend -> conversion_worker: "conversion.sock" {
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.stroke-dash: 5
  }

  conversion_worker -> inference_worker: "reload_model\n(.engine listo)" {
    style.stroke: "#1F4E79"
    style.stroke-width: 2
    style.stroke-dash: 3
  }

  recording_worker -> sqlite: "MP4 + metadata" {
    style.stroke: "#999999"
  }

  backend -> sqlite {
    style.stroke: "#999999"
  }
}

cliente: "Cliente\n(Navegador Web)" {
  style.fill: "#FFFFFF"
  style.stroke: "#1F4E79"
  style.stroke-width: 2
}

cliente -> robot.nginx: "HTTP" {
  style.stroke: "#2E7D32"
  style.stroke-width: 2
}

robot.backend -> cliente: "WebRTC\n(video H.264 + detecciones)" {
  style.stroke: "#2E7D32"
  style.stroke-width: 3
}
