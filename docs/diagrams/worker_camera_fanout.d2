direction: right

cam: "Cámara USB\n(V4L2)" {
  style.fill: "#E8F4FD"
  style.stroke: "#1F4E79"
  style.stroke-width: 2
  style.font-size: 32
}

cw: "camera-worker" {
  style.fill: "#FFE0B2"
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.font-size: 32

  crop: "crop" {
    style.fill: "#FFF3E0"
    style.stroke: "#E65100"
    style.font-size: 28
  }

  q1: "cola backend" {
    style.fill: "#FFF3E0"
    style.stroke: "#E65100"
    style.font-size: 28
    shape: queue
  }

  q2: "cola recording" {
    style.fill: "#FFF3E0"
    style.stroke: "#E65100"
    style.font-size: 28
    shape: queue
  }

  crop -> q1: "fan-out" {
    style.stroke: "#E65100"
    style.font-size: 28
  }
  crop -> q2: "fan-out" {
    style.stroke: "#E65100"
    style.font-size: 28
  }
}

backend: "Backend" {
  style.fill: "#D5E8F0"
  style.stroke: "#1F4E79"
  style.stroke-width: 2
  style.font-size: 32
}

rec: "recording-worker" {
  style.fill: "#FFE0B2"
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.font-size: 32
}

cam -> cw.crop: "V4L2" {
  style.stroke: "#1F4E79"
  style.stroke-width: 2
  style.font-size: 28
}

cw.q1 -> backend: "camera.sock" {
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.stroke-dash: 5
  style.font-size: 28
}

cw.q2 -> rec: "camera.sock" {
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.stroke-dash: 5
  style.font-size: 28
}
