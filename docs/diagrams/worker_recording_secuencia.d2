direction: right

cw: "camera-worker" {
  style.fill: "#FFE0B2"
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.font-size: 32
}

backend: "Backend" {
  style.fill: "#D5E8F0"
  style.stroke: "#1F4E79"
  style.stroke-width: 2
  style.font-size: 32
}

rec: "recording-worker" {
  style.fill: "#FFE0B2"
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.font-size: 32

  enc: "NVENC H.264" {
    style.fill: "#FFF3E0"
    style.stroke: "#E65100"
    style.font-size: 28
  }
}

disco: "MP4 en disco" {
  style.fill: "#F5F5F5"
  style.stroke: "#999999"
  shape: cylinder
  style.font-size: 28
}

cw -> rec.enc: "camera.sock" {
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.stroke-dash: 5
  style.font-size: 28
}

backend -> rec.enc: "recording.sock" {
  style.stroke: "#1F4E79"
  style.stroke-width: 2
  style.stroke-dash: 3
  style.font-size: 28
}

rec.enc -> disco: "MP4" {
  style.stroke: "#999999"
  style.font-size: 28
}
