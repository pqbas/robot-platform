direction: down

front: "Navegador del cliente (SPA React + Vite)" {
  style.fill: "#E8F4FD"
  style.stroke: "#1F4E79"
  style.stroke-width: 2
  style.font-size: 28

  cliente: "Cliente HTTP único\n(JWT Bearer)" {
    style.fill: "#FFFFFF"
    style.stroke: "#1F4E79"
    style.font-size: 26
  }
  video: "Capa de video\n(WebCodecs / WebRTC / MJPEG)" {
    style.fill: "#FFFFFF"
    style.stroke: "#1F4E79"
    style.font-size: 26
  }
}

nginx: "nginx\n(estáticos + proxy)" {
  style.fill: "#FFF3E0"
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.font-size: 28
}

back: "Backend FastAPI\n(modo robot / servidor)" {
  style.fill: "#F3E5F5"
  style.stroke: "#6A1B9A"
  style.stroke-width: 2
  style.font-size: 28
}

front.cliente -> nginx: "REST / JSON" {
  style.stroke: "#6A1B9A"
  style.stroke-width: 3
  style.font-size: 24
}
front.video -> nginx: "WS / WebRTC" {
  style.stroke: "#1F4E79"
  style.stroke-width: 3
  style.stroke-dash: 5
  style.font-size: 24
}
nginx -> back: "datos + video" {
  style.stroke: "#6A1B9A"
  style.stroke-width: 3
  style.font-size: 24
}
